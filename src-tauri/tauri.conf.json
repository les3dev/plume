{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Plume",
    "version": "../package.json",
    "identifier": "dev.les3.plume",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../build"
    },
    "app": {
        "trayIcon": {
            "iconPath": "icons/tray-icon.png",
            "iconAsTemplate": true
        },
        "windows": [
            {
                "title": "Plume",
                "width": 600,
                "height": 800,
                "visible": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; asset: 'self'; img-src 'self' asset: https://asset.localhost; media-src asset: https://asset.localhost; connect-src 'self' https://api.deepgram.com https://openrouter.ai",
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/**", "$HOME/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "11.0",
            "entitlements": "./entitlements.plist",
            "infoPlist": "./Info.plist"
        },
        "resources": {
            "target/release/libAudioCapture.dylib": "libAudioCapture.dylib"
        },
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "shell": {
            "open": true
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQjkwQjJFQUU4RjFCNDYKUldSR0c0K3VMZ3U1TGtSS3BJZ0VEQ0c4Wkl3blFlU2x1bllneGsxZ2Vnd2pjeU9BN2t6dCs2OGgK",
            "endpoints": ["https://github.com/les3dev/plume/releases/latest/download/latest.json"]
        }
    }
}
